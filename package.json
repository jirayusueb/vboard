{
  "name": "vboard",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "elysia": "^1.4.28",
      "@elysiajs/eden": "^1.4.8",
      "eden-tanstack-react-query": "^0.1.9",
      "better-result": "^2.9.2",
      "better-auth": "1.6.9",
      "evlog": "^2.14.1",
      "next-themes": "^0.4.6",
      "@types/react-dom": "^19.2.3",
      "drizzle-orm": "^0.45.1",
      "@types/pg": "^8.16.0",
      "yjs": "^13.6.30",
      "lib0": "^0.2.117",
      "@y/protocols": "^1.0.6-0",
      "vitest": "^3.2.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @vboard/db db:push",
    "db:studio": "turbo -F @vboard/db db:studio",
    "db:generate": "turbo -F @vboard/db db:generate",
    "db:migrate": "turbo -F @vboard/db db:migrate",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@vboard/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@vboard/config": "workspace:*",
    "@y/protocols": "^1.0.6-0",
    "lib0": "^0.2.117",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.6.4",
    "yjs": "^13.6.30"
  },
  "packageManager": "bun@1.3.12"
}
