# ── Server URL ─────────────────────────────────────────────
# Public URL of the API server (used by Eden client + API fetches)
VITE_SERVER_URL=http://localhost:3000

# ── WebSocket URL (optional) ──────────────────────────────
# Override the WebSocket URL derived from VITE_SERVER_URL.
# Useful when behind a reverse proxy that handles WS separately.
# VITE_WS_URL=ws://localhost:3000
