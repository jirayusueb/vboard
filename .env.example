# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://vboard:vboard@localhost:5432/vboard

# ── Auth ───────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-at-least-32-chars-long-for-security

# Public-facing URL of the server (used by better-auth for callbacks/cookies)
BETTER_AUTH_URL=http://localhost:3000

# ── CORS ───────────────────────────────────────────────────
# Allowed origin for cross-origin requests (single origin URL)
CORS_ORIGIN=http://localhost:3001

# ── Server ─────────────────────────────────────────────────
# Port the server listens on
PORT=3000

# ── Environment ────────────────────────────────────────────
NODE_ENV=development

# ── Database Pool (optional, defaults shown) ───────────────
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=30
# DB_POOL_CONNECT_TIMEOUT=10
